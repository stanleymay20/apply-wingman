# Public frontend configuration only. Never put service-role keys, provider
# secrets, API tokens, or passwords in this file or in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# The ATS browser worker runs in GitHub Actions and requires repository secrets,
# not values committed here:
#   SUPABASE_SERVICE_ROLE_KEY
# Optional repository secret override:
#   SUPABASE_URL
